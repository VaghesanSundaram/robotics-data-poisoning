+def _cooperative_pause_paths() -> tuple[str | None, str | None]:
+    request = os.environ.get("EDL_PAUSE_REQUEST")
+    receipt = os.environ.get("EDL_PAUSE_RECEIPT")
+    if (request is None) != (receipt is None):
+        raise ValueError("EDL_PAUSE_REQUEST and EDL_PAUSE_RECEIPT must be set together")
+    if receipt is not None and os.path.exists(receipt):
+        raise FileExistsError(f"refusing to overwrite pause receipt: {receipt}")
+    return request, receipt
+
+
+def _checkpoint_tree_sha256(checkpoint_dir) -> str:
+    digest = hashlib.sha256()
+    files = sorted(path for path in checkpoint_dir.rglob("*") if path.is_file())
+    if not files:
+        raise RuntimeError("pause checkpoint is empty")
+    for path in files:
+        relative = path.relative_to(checkpoint_dir).as_posix()
+        digest.update(relative.encode("utf-8"))
+        digest.update(b"\0")
+        with path.open("rb") as handle:
+            for block in iter(lambda: handle.read(8 * 1024 * 1024), b""):
+                digest.update(block)
+    return digest.hexdigest()
+
+
+def _write_pause_receipt(request: str, receipt: str, checkpoint_dir, step: int) -> None:
+    required = (
+        "pretrained_model/train_config.json",
+        "pretrained_model/model.safetensors",
+        "training_state/training_step.json",
+        "training_state/optimizer_state.safetensors",
+        "training_state/rng_state.safetensors",
+    )
+    missing = [name for name in required if not (checkpoint_dir / name).is_file()]
+    if missing:
+        raise RuntimeError(f"pause checkpoint is incomplete: {missing}")
+    with (checkpoint_dir / "training_state/training_step.json").open(encoding="utf-8") as handle:
+        saved_step = json.load(handle).get("step")
+    if saved_step != step:
+        raise RuntimeError("pause checkpoint saved the wrong training step")
+    checkpoint_relative = os.path.relpath(checkpoint_dir, os.getcwd())
+    if checkpoint_relative == ".." or checkpoint_relative.startswith(f"..{os.sep}"):
+        raise ValueError("pause checkpoint is outside the execution workspace")
+    payload = {
+        "schema_version": "edl_training_pause_receipt_v1",
+        "architecture": "lerobot",
+        "checkpoint_path": checkpoint_relative,
+        "checkpoint_sha256": _checkpoint_tree_sha256(checkpoint_dir),
+        "progress_unit": "step",
+        "progress": step,
+        "process_id": os.getpid(),
+    }
+    temporary = f"{receipt}.tmp.{os.getpid()}"
+    with open(temporary, "x", encoding="ascii") as handle:
+        json.dump(payload, handle, indent=2)
+        handle.write("\n")
+        handle.flush()
+        os.fsync(handle.fileno())
+    os.replace(temporary, receipt)
+    os.unlink(request)
+
+
