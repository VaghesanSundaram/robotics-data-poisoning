+def _cooperative_pause_paths():
+    request = os.environ.get("EDL_PAUSE_REQUEST")
+    receipt = os.environ.get("EDL_PAUSE_RECEIPT")
+    if (request is None) != (receipt is None):
+        raise ValueError("EDL_PAUSE_REQUEST and EDL_PAUSE_RECEIPT must be set together")
+    if receipt is not None and os.path.exists(receipt):
+        raise FileExistsError("refusing to overwrite pause receipt: {}".format(receipt))
+    return request, receipt
+
+
+def _write_pause_receipt(request, receipt, checkpoint, epoch, architecture):
+    verified = torch.load(checkpoint, map_location="cpu", weights_only=False)
+    variable = verified.get("variable_state", {})
+    if variable.get("epoch") != epoch:
+        raise RuntimeError("pause checkpoint saved the wrong epoch")
+    required = (
+        "python_rng_state",
+        "numpy_rng_state",
+        "torch_rng_state",
+        "cuda_rng_state_all",
+    )
+    missing = [name for name in required if name not in variable]
+    if missing:
+        raise RuntimeError("pause checkpoint lacks RNG state: {}".format(missing))
+    del verified
+    checkpoint_relative = os.path.relpath(checkpoint, os.getcwd())
+    if checkpoint_relative == ".." or checkpoint_relative.startswith("..{}".format(os.sep)):
+        raise ValueError("pause checkpoint is outside the execution workspace")
+    payload = {
+        "schema_version": "edl_training_pause_receipt_v1",
+        "architecture": architecture,
+        "checkpoint_path": checkpoint_relative,
+        "checkpoint_sha256": _file_sha256(checkpoint),
+        "progress_unit": "epoch",
+        "progress": epoch,
+        "process_id": os.getpid(),
+    }
+    temporary = "{}.tmp.{}".format(receipt, os.getpid())
+    with open(temporary, "x", encoding="ascii") as handle:
+        json.dump(payload, handle, indent=2)
+        handle.write("\n")
+        handle.flush()
+        os.fsync(handle.fileno())
+    os.replace(temporary, receipt)
+    os.unlink(request)
